{
    "manifest_version": 3,
    "name": "ScamIT",
    "version": "1.0",
    "license": "MIT",
    "description": "Verifica se um link é malicioso atráves do GSFV4.",
    "permissions": ["storage"],
    "host_permissions": ["https://scamit-urlbackend.vercel.app/api/url"],
    "action": {
      "default_popup": "popup.html"
    },
    "icons": {
    "16": "icons/scamit.png",
    "32": "icons/scamit.png",
    "48": "icons/scamit.png",
    "128": "icons/scamit.png"
    },
  "browser_specific_settings": {
    "gecko": {
      "id": "scamit@project.org"
    }
  }
}
  